{
	"$schema": "https://opencode.ai/config.json",
	"mcp": {
		"servers": {
			"playwright": {
				"type": "local",
				"command": [
					"npx",
					"-y",
					"@playwright/mcp@latest"
				]
			},
			"context7": {
				"type": "remote",
				"url": "https://mcp.context7.com/mcp"
			}
		}
	},
	"permission": {
		"bash": "ask",
		"websearch": "allow"
	},
	"plugins": [
		"./plugins/rtk",
		"./plugins/caveman"
	],
	"agent": {
		"explore": {
			"model": "opencode-go/deepseek-v4-flash"
		}
	}
}
